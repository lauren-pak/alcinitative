rules_version = '2';

// Athlete App security rules. These enforce the safeguarding and PDPA rules
// on Google's servers; the app only mirrors them. Deploy with:
//   npx -y firebase-tools@latest deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function cardPath(athleteId) {
      return /databases/$(database)/documents/athleteIds/$(athleteId);
    }

    // Under 18 right now, based on the stored date they turn 18.
    function isMinor(uid) {
      return get(userPath(uid)).data.adultFrom > request.time;
    }

    function validEnum(value, allowed) {
      return value == null || value in allowed;
    }

    // Fields shown on the ID card (no date of birth).
    function validPublicFields(data) {
      return data.role in ['athlete', 'public']
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && (data.sport == null || (data.sport is string && data.sport.size() <= 40))
        && data.customSport is string && data.customSport.size() <= 40
        && validEnum(data.level, ['school', 'club', 'regional', 'national', 'elite'])
        && validEnum(data.category, ['national', 'paralympic', 'specialOlympics']);
    }

    function validProfile(data) {
      return data.keys().hasOnly(['role', 'name', 'sport', 'customSport',
          'level', 'category', 'topics', 'signUpMethod', 'dateOfBirth',
          'adultFrom', 'athleteId', 'createdAt', 'consent', 'displayMode',
          'mutedTopics', 'findable'])
        && data.get('mutedTopics', []) is list
        && data.get('findable', false) is bool
        && validEnum(data.get('displayMode', null), ['standard', 'easy'])
        && validPublicFields(data)
        && data.topics is list && data.topics.size() <= 4
        && data.dateOfBirth is timestamp
        // 13 or older: under-13s need parental consent under the PDPA, so
        // the app doesn't accept them.
        && data.dateOfBirth < request.time - duration.value(4745, 'd')
        // adultFrom must really be the 18th birthday (6574-6576 days later),
        // so nobody can switch off under-18 protections early.
        && data.adultFrom is timestamp
        && data.adultFrom > data.dateOfBirth + duration.value(6573, 'd')
        && data.adultFrom < data.dateOfBirth + duration.value(6577, 'd')
        && data.athleteId is string;
    }

    // Private profile: only the owner can read or change it.
    match /users/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.consent.version is string
        && request.resource.data.consent.acceptedAt is timestamp
        && getAfter(cardPath(request.resource.data.athleteId)).data.ownerUid == uid;

      // Date of birth, athlete ID and the consent record can't be edited.
      allow update: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'sport', 'customSport', 'level', 'category',
                       'topics', 'displayMode', 'mutedTopics', 'findable']);

      // Members this person blocked. Private; the feed rules also check it
      // so blocked members can't reply to this person's posts.
      match /blocked/{otherUid} {
        allow get, list, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && otherUid != uid
          && request.resource.data.keys().hasOnly(['name', 'createdAt']);
      }

      // Private list of everything this member created, so deleting the
      // account can delete it all (PDPA: withdrawing consent).
      match /contributions/{contributionId} {
        allow get, list, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['path', 'storage'])
          && request.resource.data.path is string;
      }
    }

    // Public ID card, looked up by exact ID. Only adult athletes who opted in
    // ('findable') can be found by name; under-18s never can (PDPC
    // children's guidelines).

    // Name search: opt-in, adult athletes only, and the search keys are
    // only stored while it's on.
    // [minor]: whether the writer is under 18 (on create, the profile is
    // written in the same transaction, so it's read with getAfter).
    function validFindable(d, minor) {
      let findable = d.get('findable', false);
      let keys = d.get('searchKeys', []);
      return findable is bool && keys is list && keys.size() <= 60
        && (findable
            ? d.role == 'athlete' && !minor
            : keys.size() == 0);
    }

    match /athleteIds/{athleteId} {
      // Under-18 cards are only visible to their owner and other under-18s.
      // Reading a missing ID is allowed so sign-up can check it's free.
      allow get: if signedIn() && (
        resource == null
        || resource.data.ownerUid == request.auth.uid
        || !isMinor(resource.data.ownerUid)
        || isMinor(request.auth.uid));
      // Search queries must ask for findable cards only.
      allow list: if signedIn() && resource.data.findable == true;

      // Created together with the owner's profile, once per member.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'role', 'name',
             'sport', 'customSport', 'level', 'category', 'joinedAt',
             'findable', 'searchKeys'])
        && request.resource.data.ownerUid == request.auth.uid
        && validPublicFields(request.resource.data)
        && validFindable(request.resource.data,
             getAfter(userPath(request.auth.uid)).data.adultFrom > request.time)
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.athleteId == athleteId;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && validPublicFields(request.resource.data)
        && validFindable(request.resource.data, isMinor(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'sport', 'customSport', 'level', 'category',
                       'findable', 'searchKeys']);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    // ---------------------------------------------------------------------
    // Feed. See docs/feed-design.md. Mirrored in the app by FeedRules.
    // ---------------------------------------------------------------------

    function profile() {
      return get(userPath(request.auth.uid)).data;
    }

    function postPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    function authorLinkPath(postId) {
      return /databases/$(database)/documents/postAuthors/$(postId);
    }

    // The private author link, which also covers anonymous posts.
    function isPostAuthor(postId) {
      return get(authorLinkPath(postId)).data.uid == request.auth.uid;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(keys);
    }

    // Author fields must match the writer's real ID card.
    function authorMatches(d) {
      let p = profile();
      return d.authorUid == request.auth.uid
        && d.authorName == p.name
        && d.authorSport == (p.role == 'athlete'
             ? (p.sport == 'Other' ? p.customSport : p.sport) : null)
        && d.authorLevel == p.level
        && d.authorCategory == p.category;
    }

    function mediaOwnerPath(id) {
      return /databases/$(database)/documents/mediaOwners/$(id);
    }

    // One attached photo or video, uploaded by this member.
    function validMedia(m) {
      return m.keys().hasOnly(['id', 'kind', 'width', 'height', 'durationMs'])
        && m.kind in ['photo', 'video']
        && m.width is int && m.height is int
        && get(mediaOwnerPath(m.id)).data.uid == request.auth.uid
        && get(mediaOwnerPath(m.id)).data.kind == m.kind;
    }

    // Up to 4 photos, or a single video.
    function validMediaList(media) {
      return media is list && media.size() <= 4
        && (media.size() < 1 || validMedia(media[0]))
        && (media.size() < 2 || validMedia(media[1]))
        && (media.size() < 3 || validMedia(media[2]))
        && (media.size() < 4 || validMedia(media[3]))
        && (media.size() <= 1
            || (media[0].kind == 'photo' && media[1].kind == 'photo'
                && (media.size() < 3 || media[2].kind == 'photo')
                && (media.size() < 4 || media[3].kind == 'photo')));
    }

    // ----- Moderation (stage 2). Mirrored in lib/models/moderation.dart.

    // Listed in moderators/{uid}, added by hand in the Firebase console.
    function isModerator() {
      return signedIn() && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }

    // Words suggesting someone is struggling or giving dangerous advice.
    // MUST match flaggedWordsPattern in lib/models/moderation.dart.
    function flagged(text) {
      return text.lower().matches('(?s).*(purg|starv|laxative|diet pill|skip(ping)? meals|not eating|stop(ped)? eating|throw(ing)? up|make myself sick|cut(ting)? weight fast|weight cut|self.?harm|cutting myself|hurt myself|kill myself|suicid|want to die|end it all).*');
    }

    // New content is 'visible' or 'held'; it must be 'held' when [mustHold].
    function validStatus(d, mustHold) {
      return d.status in ['visible', 'held']
        && (d.status == 'held' || !mustHold)
        && (d.status == 'visible' || d.holdReason is string)
        && d.reportCount == 0;
    }

    // Up to 5 tags: lowercase letters and numbers, 2-20 long (normaliseTag).
    function validTag(t) {
      return t is string && t.matches('[a-z0-9]{2,20}');
    }

    function validTags(tags) {
      return tags is list && tags.size() <= 5
        && (tags.size() < 1 || validTag(tags[0]))
        && (tags.size() < 2 || validTag(tags[1]))
        && (tags.size() < 3 || validTag(tags[2]))
        && (tags.size() < 4 || validTag(tags[3]))
        && (tags.size() < 5 || validTag(tags[4]));
    }

    // Flagged words in a post's text or its tags.
    function postFlagged(d) {
      return flagged(d.text + ' ' + d.get('tags', []).join(' '));
    }

    // The author changes the text or tags. Adding flagged words sends a
    // visible post back for review; otherwise the status can't change.
    function validEdit(postId) {
      let d = request.resource.data;
      let oldStatus = resource.data.get('status', 'visible');
      let newStatus = d.get('status', 'visible');
      return isPostAuthor(postId)
        && onlyChanged(['text', 'tags', 'editedAt', 'status', 'holdReason'])
        && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
        && validTags(d.get('tags', []))
        && d.editedAt == request.time
        && ((newStatus == oldStatus
              && d.get('holdReason', null) == resource.data.get('holdReason', null))
            || (oldStatus == 'visible' && newStatus == 'held'
                && d.holdReason == 'flaggedWords'))
        && (newStatus != 'visible' || !postFlagged(d));
    }

    function hasVideo(media) {
      return media.size() > 0 && media[0].kind == 'video';
    }

    // Has the owner of [postId] blocked the requester?
    function blockedByPostOwner(postId) {
      let owner = get(authorLinkPath(postId)).data.uid;
      return exists(/databases/$(database)/documents/users/$(owner)/blocked/$(request.auth.uid));
    }

    // A report raises the count by one alongside the reporter's new report,
    // and the 3rd report hides it for review.
    function reportCounted(reportPath) {
      let before = resource.data.get('reportCount', 0);
      let after = request.resource.data.reportCount;
      let oldStatus = resource.data.get('status', 'visible');
      let newStatus = request.resource.data.get('status', 'visible');
      return onlyChanged(['reportCount', 'status', 'holdReason'])
        && after == before + 1
        && !exists(reportPath) && existsAfter(reportPath)
        && (newStatus == oldStatus
            || (oldStatus == 'visible' && newStatus == 'held' && after >= 3
                && request.resource.data.holdReason == 'reports'));
    }

    function moderatorStatusChange() {
      return isModerator()
        && onlyChanged(['status', 'holdReason'])
        && request.resource.data.status in ['visible', 'held', 'removed'];
    }

    // ----- Verification (step 3): moderators or organisers verify
    // national, Paralympic and Special Olympics athletes.

    function isVerified(uid) {
      return exists(/databases/$(database)/documents/verifiedAthletes/$(uid));
    }

    function isReviewer() {
      return isModerator() || isOrganiser();
    }

    // The ✓ on a post or reply must be true exactly when the writer is
    // verified (anonymous posts leave it out).
    function verifiedFlagMatches(d) {
      return !d.keys().hasAny(['authorVerified'])
        || d.authorVerified == isVerified(request.auth.uid);
    }

    function canRespondTo(postId, p, minor) {
      let target = get(postPath(postId)).data;
      return target.replyPolicy != 'none'
        && (target.replyPolicy == 'everyone' || p.role == 'athlete')
        && (!target.minorAuthor || minor || target.get('adultRepliesAllowed', false));
    }

    function validNewPost(d) {
      let p = profile();
      let minor = isMinor(request.auth.uid);
      return d.keys().hasOnly(['type', 'topic', 'text', 'createdAt',
          'authorRole', 'minorAuthor', 'replyPolicy', 'anonymous', 'answered',
          'replyCount', 'beenThereCount', 'authorUid', 'authorName',
          'authorSport', 'authorLevel', 'authorCategory', 'journeyId',
          'journeyTitle', 'media', 'responseCount', 'respondsToId',
          'respondsToText', 'status', 'holdReason', 'reportCount',
          'adultRepliesAllowed', 'tags', 'authorVerified', 'promptId',
          'promptText'])
        // Spotlights come from verified athletes; anyone can ask.
        && (d.type == 'question' || isVerified(request.auth.uid))
        && verifiedFlagMatches(d)
        // Answering the weekly Huddle question.
        && (!d.keys().hasAny(['promptId'])
            || (d.promptText is string && d.promptText.size() <= 200
                && exists(/databases/$(database)/documents/prompts/$(d.promptId))))
        && validTags(d.get('tags', []))
        && d.type in ['experience', 'question']
        // General public members can only ask questions.
        && (p.role == 'athlete' || d.type == 'question')
        // Huddle categories (the old problem-focused topics are retired).
        && d.topic in ['training', 'mindset', 'gameDay', 'teamLife']
        // Held for a moderator: flagged words; under-18 videos; adults
        // responding to an under-18 who allowed adult replies.
        // Every "Ask an athlete" question is checked before it appears.
        && validStatus(d, postFlagged(d)
             || d.type == 'question'
             || (minor && hasVideo(d.get('media', [])))
             || (d.keys().hasAny(['respondsToId']) && !minor
                 && get(postPath(d.respondsToId)).data.minorAuthor))
        // Only under-18s can open their posts to adult replies.
        && d.adultRepliesAllowed is bool && (!d.adultRepliesAllowed || minor)
        && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
        && d.createdAt == request.time
        && d.authorRole == p.role
        && d.minorAuthor == minor
        && d.replyPolicy in ['athletes', 'everyone', 'none']
        && d.anonymous is bool
        && d.answered == false && d.replyCount == 0 && d.beenThereCount == 0
        && d.get('responseCount', 0) == 0
        && validMediaList(d.get('media', []))
        // A response post obeys the same rules as a reply to that post.
        && (!d.keys().hasAny(['respondsToId'])
            || (d.respondsToText is string
                && d.respondsToText.size() <= 120
                && canRespondTo(d.respondsToId, p, minor)))
        // Anonymous posts carry no author or journey fields at all.
        && (d.anonymous
              ? !d.keys().hasAny(['authorUid', 'authorName', 'authorSport',
                  'authorLevel', 'authorCategory', 'journeyId', 'journeyTitle'])
              : authorMatches(d))
        && (!d.keys().hasAny(['journeyId'])
              || get(/databases/$(database)/documents/journeys/$(d.journeyId))
                   .data.ownerUid == request.auth.uid);
    }

    function validReply(postId, d) {
      let p = profile();
      let post = get(postPath(postId)).data;
      let minor = isMinor(request.auth.uid);
      return d.keys().hasOnly(['authorUid', 'authorName', 'authorSport',
          'authorLevel', 'authorCategory', 'authorRole', 'minorAuthor', 'text',
          'createdAt', 'helpfulCount', 'helpedAsker', 'parentReplyId',
          'status', 'holdReason', 'reportCount', 'authorVerified'])
        && authorMatches(d)
        && verifiedFlagMatches(d)
        // "Ask an athlete": verified athletes answer; the asker can reply.
        && (post.type != 'question' || isVerified(request.auth.uid)
            || isPostAuthor(postId))
        && d.authorRole == p.role
        && d.minorAuthor == minor
        && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
        && d.createdAt == request.time
        && d.helpfulCount == 0 && d.helpedAsker == false
        // The poster's choice of who may reply.
        && post.replyPolicy != 'none'
        && (post.replyPolicy == 'everyone' || p.role == 'athlete')
        // Adults reply to under-18 posts only if the poster allowed it, and
        // those replies wait for a moderator. Flagged words wait too.
        && (!post.minorAuthor || minor || post.get('adultRepliesAllowed', false))
        && validStatus(d, flagged(d.text) || (post.minorAuthor && !minor))
        // Someone the post's author blocked can't reply.
        && !blockedByPostOwner(postId)
        // A nested reply: the parent must exist, and adults can't reply to
        // an under-18's reply either.
        && (!d.keys().hasAny(['parentReplyId'])
            || (exists(/databases/$(database)/documents/posts/$(postId)/replies/$(d.parentReplyId))
                && (!get(/databases/$(database)/documents/posts/$(postId)/replies/$(d.parentReplyId)).data.minorAuthor
                    || minor)));
    }

    // A counter moves by exactly one, together with the matching reaction.
    function counterMoved(field, reaction) {
      let before = resource.data[field];
      let after = request.resource.data[field];
      return onlyChanged([field]) && (
        (after == before + 1 && !exists(reaction) && existsAfter(reaction))
        || (after == before - 1 && exists(reaction) && !existsAfter(reaction)));
    }

    match /posts/{postId} {
      // Members only, never public. Feed queries must ask for visible posts
      // only; held posts are seen by their author and moderators.
      // Reading a deleted post just finds nothing.
      allow get: if signedIn() && (resource == null
        || resource.data.get('status', 'visible') == 'visible'
        || isModerator() || isPostAuthor(postId));
      allow list: if signedIn()
        && (resource.data.status == 'visible' || isModerator());

      allow create: if signedIn() && validNewPost(request.resource.data)
        && getAfter(authorLinkPath(postId)).data.uid == request.auth.uid;

      allow update: if signedIn() && (
        counterMoved('beenThereCount',
          /databases/$(database)/documents/posts/$(postId)/beenThere/$(request.auth.uid))
        // A new reply: count +1 alongside a reply that didn't exist before.
        || (onlyChanged(['replyCount', 'lastReplyId'])
            && request.resource.data.replyCount == resource.data.replyCount + 1
            && !exists(/databases/$(database)/documents/posts/$(postId)/replies/$(request.resource.data.lastReplyId))
            && existsAfter(/databases/$(database)/documents/posts/$(postId)/replies/$(request.resource.data.lastReplyId)))
        // A response post: count +1 alongside a new post that responds here.
        || (onlyChanged(['responseCount', 'lastResponseId'])
            && request.resource.data.responseCount
                 == resource.data.get('responseCount', 0) + 1
            && !exists(postPath(request.resource.data.lastResponseId))
            && getAfter(postPath(request.resource.data.lastResponseId))
                 .data.respondsToId == postId)
        // The asker marks their question answered.
        || (onlyChanged(['answered'])
            && resource.data.type == 'question'
            && resource.data.answered == false
            && request.resource.data.answered == true
            && isPostAuthor(postId))
        || reportCounted(/databases/$(database)/documents/reports/$('posts_' + postId + '__' + request.auth.uid))
        || moderatorStatusChange()
        || validEdit(postId));

      // Deleting something already gone is harmless (account deletion may
      // revisit a post deleted earlier).
      allow delete: if signedIn() && (resource == null || isPostAuthor(postId));

      match /replies/{replyId} {
        allow get: if signedIn() && (
          resource.data.get('status', 'visible') == 'visible'
          || resource.data.authorUid == request.auth.uid || isModerator());
        allow list: if signedIn() && (
          resource.data.status == 'visible'
          || resource.data.authorUid == request.auth.uid || isModerator());
        allow create: if signedIn() && validReply(postId, request.resource.data)
          && getAfter(postPath(postId)).data.lastReplyId == replyId;
        allow update: if signedIn() && (
          counterMoved('helpfulCount',
            /databases/$(database)/documents/posts/$(postId)/replies/$(replyId)/helpful/$(request.auth.uid))
          // The asker picks the reply that helped, answering the question.
          || (onlyChanged(['helpedAsker'])
              && resource.data.helpedAsker == false
              && request.resource.data.helpedAsker == true
              && isPostAuthor(postId)
              && get(postPath(postId)).data.answered == false
              && getAfter(postPath(postId)).data.answered == true)
          || reportCounted(/databases/$(database)/documents/reports/$('posts_' + postId + '_replies_' + replyId + '__' + request.auth.uid))
          || moderatorStatusChange());
        allow delete: if signedIn()
          && (resource == null || resource.data.authorUid == request.auth.uid);

        match /helpful/{uid} {
          allow get, delete: if signedIn() && request.auth.uid == uid;
          allow create: if signedIn() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
            && request.resource.data.uid == uid;
        }
      }

      match /beenThere/{uid} {
        allow get, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == uid;
      }
    }

    // Private link from a post to its author. Only the author can read it,
    // so anonymous posts stay anonymous to everyone else.
    match /postAuthors/{postId} {
      allow get: if signedIn()
        && (resource.data.uid == request.auth.uid || isModerator());
      allow delete: if signedIn()
        && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(postPath(postId)) && existsAfter(postPath(postId));
    }

    // Private owner of each uploaded photo or video. Only the owner can read
    // it, so media on anonymous posts can't be traced. The storage rules
    // check it before allowing uploads and deletes.
    match /mediaOwners/{mediaId} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'kind'])
        && request.resource.data.uid == request.auth.uid
        // Under-18 videos are allowed; their posts are held for review.
        && request.resource.data.kind in ['photo', 'video'];
    }

    // Moderators query held replies across all posts.
    match /{path=**}/replies/{replyId} {
      allow list: if isModerator();
    }

    // Who moderates. Managed by hand in the Firebase console; members can
    // only check their own entry.
    match /moderators/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // One report per member per item; the ID encodes both (see reportId()).
    match /reports/{reportId} {
      // Reading a missing report is allowed so the app can check for a
      // duplicate before reporting.
      allow get: if signedIn() && (resource == null
        || resource.data.reporterUid == request.auth.uid || isModerator());
      allow list: if isModerator();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterUid', 'targetPath',
             'targetText', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && reportId == request.resource.data.targetPath.replace('/', '_')
             + '__' + request.auth.uid
        && request.resource.data.reason in ['bullying', 'unsafeAdvice',
             'inappropriate', 'wellbeing', 'spam', 'other']
        && request.resource.data.details.size() <= 500
        && request.resource.data.targetText.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update: if isModerator()
        && onlyChanged(['status', 'action', 'resolvedAt']);
      // Deleting an account deletes its reports.
      allow delete: if signedIn()
        && (resource == null || resource.data.reporterUid == request.auth.uid);
    }

    // ---------------------------------------------------------------------
    // Events: in-person social sporting events. Organisers create them;
    // members RSVP. See docs/events.md. Mirrored in the app by EventRules.
    // ---------------------------------------------------------------------

    // Listed in organisers/{uid}, added by hand in the Firebase console.
    function isOrganiser() {
      return signedIn() && exists(/databases/$(database)/documents/organisers/$(request.auth.uid));
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function rsvpPath(eventId, uid) {
      return /databases/$(database)/documents/events/$(eventId)/rsvps/$(uid);
    }

    function validEvent(d) {
      return d.keys().hasOnly(['title', 'description', 'sport', 'startsAt',
          'endsAt', 'area', 'meetingPoint', 'accessibility',
          'safeguardingLead', 'capacity', 'goingCount', 'adultsOnly',
          'cancelled', 'createdBy', 'createdAt'])
        && d.title is string && d.title.size() > 2 && d.title.size() <= 80
        && d.description is string && d.description.size() <= 2000
        && (d.sport == null || (d.sport is string && d.sport.size() <= 40))
        && d.startsAt is timestamp && d.endsAt is timestamp
        && d.endsAt > d.startsAt
        && d.area is string && d.area.size() > 0 && d.area.size() <= 80
        && d.meetingPoint is string && d.meetingPoint.size() <= 200
        && d.accessibility is string && d.accessibility.size() <= 500
        // Every event names who is responsible for safety on the day.
        && d.safeguardingLead is string && d.safeguardingLead.size() > 1
        && d.safeguardingLead.size() <= 80
        && d.capacity is int && d.capacity >= 1 && d.capacity <= 500
        && d.goingCount is int && d.goingCount >= 0
        && d.capacity >= d.goingCount
        && d.adultsOnly is bool && d.cancelled is bool;
    }

    // goingCount moves by one together with the requester's own RSVP
    // becoming (or stopping being) 'going', and never past capacity.
    function goingMoved(eventId) {
      let before = resource.data.goingCount;
      let after = request.resource.data.goingCount;
      let rsvp = rsvpPath(eventId, request.auth.uid);
      let wasGoing = exists(rsvp) && get(rsvp).data.status == 'going';
      let isGoing = existsAfter(rsvp) && getAfter(rsvp).data.status == 'going';
      return onlyChanged(['goingCount'])
        && ((after == before + 1 && after <= resource.data.capacity
              && !wasGoing && isGoing)
            || (after == before - 1 && wasGoing && !isGoing));
    }

    function validRsvp(eventId, d) {
      let event = get(eventPath(eventId)).data;
      let after = getAfter(eventPath(eventId)).data;
      let minor = isMinor(request.auth.uid);
      return d.keys().hasOnly(['uid', 'name', 'status', 'supportPerson',
          'minor', 'guardianName', 'guardianPhone', 'guardianConsent',
          'createdAt'])
        && d.uid == request.auth.uid
        && d.name == get(userPath(request.auth.uid)).data.name
        && d.supportPerson is bool
        && d.createdAt == request.time
        && d.minor == minor
        && event.cancelled == false && event.startsAt > request.time
        && (!event.adultsOnly || !minor)
        // Under-18s need a parent or guardian's consent and contact; adults
        // don't store any guardian details.
        && (minor
              ? (d.guardianName is string && d.guardianName.size() > 1
                  && d.guardianName.size() <= 80
                  && d.guardianPhone is string
                  && d.guardianPhone.matches('[+0-9 ]{8,16}')
                  && d.guardianConsent == true)
              : !d.keys().hasAny(['guardianName', 'guardianPhone',
                  'guardianConsent']))
        // A spot if there is one; otherwise the waitlist.
        && ((d.status == 'going' && after.goingCount == event.goingCount + 1)
            || (d.status == 'waitlist' && event.goingCount >= event.capacity
                && after.goingCount == event.goingCount));
    }

    match /organisers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /events/{eventId} {
      allow get, list: if signedIn();
      allow create: if isOrganiser()
        && validEvent(request.resource.data)
        && request.resource.data.goingCount == 0
        && request.resource.data.cancelled == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.startsAt > request.time;
      allow update: if signedIn() && (
        goingMoved(eventId)
        || (isOrganiser() && validEvent(request.resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['goingCount', 'createdBy', 'createdAt'])));
      // Events are cancelled, never deleted, so RSVPs can still be found.
      allow delete: if false;

      match /rsvps/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isOrganiser());
        allow list: if isOrganiser();
        allow create: if signedIn() && request.auth.uid == uid
          && validRsvp(eventId, request.resource.data);
        // Taking a spot that opened up, from the waitlist.
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status'])
          && resource.data.status == 'waitlist'
          && request.resource.data.status == 'going'
          && getAfter(eventPath(eventId)).data.goingCount
               == get(eventPath(eventId)).data.goingCount + 1;
        // Cancelling: a 'going' RSVP frees its spot in the same write,
        // unless the event has already started (then it's just removed,
        // e.g. by account deletion).
        allow delete: if signedIn() && (resource == null
          || (request.auth.uid == uid
              && (resource.data.status != 'going'
                  || get(eventPath(eventId)).data.startsAt <= request.time
                  || getAfter(eventPath(eventId)).data.goingCount
                       == get(eventPath(eventId)).data.goingCount - 1)));
      }
    }

    // Verified athletes: readable by members (for the ✓), written by
    // reviewers, deleted by reviewers or with the athlete's account.
    match /verifiedAthletes/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isReviewer()
        && request.resource.data.keys().hasOnly(['programme', 'verifiedBy',
             'verifiedAt'])
        && request.resource.data.programme in ['national', 'paralympic',
             'specialOlympics']
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedAt == request.time
        && get(userPath(uid)).data.role == 'athlete';
      allow delete: if signedIn()
        && (request.auth.uid == uid || isReviewer());
    }

    // An athlete asking to be verified, one per athlete.
    match /verificationRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isReviewer());
      allow list: if isReviewer();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['athleteId', 'name', 'sport',
             'programme', 'note', 'createdAt'])
        && get(userPath(uid)).data.role == 'athlete'
        && request.resource.data.athleteId == get(userPath(uid)).data.athleteId
        && request.resource.data.name == get(userPath(uid)).data.name
        && request.resource.data.programme in ['national', 'paralympic',
             'specialOlympics']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn()
        && (resource == null || request.auth.uid == uid || isReviewer());
    }

    // The weekly Huddle question (step 4), set by moderators.
    match /prompts/{promptId} {
      allow get, list: if signedIn();
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly(['text', 'createdBy',
             'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 200
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isModerator();
    }

    // Journeys are stories: a title and intro, with posts as chapters.
    match /journeys/{journeyId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'title', 'intro',
             'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.get('intro', '') is string
        && request.resource.data.get('intro', '').size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'intro'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.intro is string
        && request.resource.data.intro.size() <= 500;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
