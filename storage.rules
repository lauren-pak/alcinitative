rules_version = '2';

// Post photos and videos. Deploy with:
//   npx -y firebase-tools@latest deploy --only storage
// Ownership lives privately in Firestore (mediaOwners/{id}), never in the
// file path, so media on anonymous posts can't be traced to the poster.
service firebase.storage {
  match /b/{bucket}/o {

    function owner(id) {
      return firestore.get(/databases/(default)/documents/mediaOwners/$(id)).data;
    }

    // media/{id}.jpg, media/{id}.mp4 or media/{id}_thumb.jpg
    match /media/{fileName} {
      // Members only. The app always fetches through these rules; it never
      // creates public download links.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && fileName.matches('[A-Za-z0-9]{20}(_thumb)?[.](jpg|mp4)')
        && owner(fileName.split('[._]')[0]).uid == request.auth.uid
        && (fileName.matches('.*[.]jpg')
            ? (request.resource.contentType == 'image/jpeg'
               && request.resource.size < 5 * 1024 * 1024)
            // Videos: only owners whose media record is a video (the
            // Firestore rules refuse those for under-18s), up to 100 MB.
            : (request.resource.contentType == 'video/mp4'
               && request.resource.size < 100 * 1024 * 1024
               && owner(fileName.split('[._]')[0]).kind == 'video'));

      allow update: if false;
      allow delete: if request.auth != null
        && owner(fileName.split('[._]')[0]).uid == request.auth.uid;
    }
  }
}
